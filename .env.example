# LLM provider: mock (default, no API key needed) | anthropic | openai
OPSPILOT_LLM_PROVIDER=mock

# Required when OPSPILOT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPSPILOT_ANTHROPIC_MODEL=

# Required when OPSPILOT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPSPILOT_OPENAI_MODEL=

# Optional: override where the CLI reaches the demo MariaDB. Only needed if
# you're not using the default docker-compose port mapping (127.0.0.1:3307).
# Inside the opspilot-api container this is instead set to mariadb-demo:3306
# via docker-compose.yml, not this file.
OPSPILOT_DEMO_MYSQL_HOST=127.0.0.1
OPSPILOT_DEMO_MYSQL_PORT=3307
